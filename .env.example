# Copy to .env; supply a real issuer reachable from the API container.
DB_PASSWORD=replace-with-a-long-random-password
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=master;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
JWT_ISSUER=https://your-identity-provider.example/realms/your-realm
JWT_AUDIENCE=sensitivewords-api
