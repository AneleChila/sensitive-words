{
  "info": {
    "name": "Sensitive Words API - local demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the local profile first. Run requests in order. For production replace Basic authentication with appropriate JWT Bearer tokens."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "admin",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{adminPassword}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "adminPassword",
      "value": "admin-demo-only"
    },
    {
      "key": "clientPassword",
      "value": "client-demo-only"
    },
    {
      "key": "wordId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. List words",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/internal/v1/sensitive-words?size=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"List returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"List contains a bounded page\", () => { const r=pm.response.json(); pm.expect(r.content).to.be.an(\"array\"); pm.expect(r.content.length).to.be.at.most(10); pm.expect(r.page).to.equal(0); pm.expect(r.size).to.equal(10); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Create word (captures wordId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/internal/v1/sensitive-words",
        "body": {
          "mode": "raw",
          "raw": "{\"value\": \"restricted phrase\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "pm.test(\"Created term has an identifier and normalized value\", () => { const r=pm.response.json(); pm.expect(r.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i); pm.expect(r.value).to.equal(\"RESTRICTED PHRASE\"); });",
              "pm.test(\"Location identifies the created term\", () => pm.expect(pm.response.headers.get(\"Location\")).to.equal(\"/api/internal/v1/sensitive-words/\" + pm.response.json().id));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"wordId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get word",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/internal/v1/sensitive-words/{{wordId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Get returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Retrieved term matches the created entry\", () => { const r=pm.response.json(); pm.expect(r.id).to.equal(pm.collectionVariables.get(\"wordId\")); pm.expect(r.value).to.equal(\"RESTRICTED PHRASE\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Filter as client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/messages/filter",
        "body": {
          "mode": "raw",
          "raw": "{\"message\": \"SELECT * FROM customers. Restricted phrase.\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "client",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{clientPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Filtered\", () => pm.response.to.have.status(200));",
              "pm.test(\"Sensitive words and phrases are masked\", () => pm.expect(pm.response.json().message).to.equal(\"****** * **** customers. ********** ******.\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Update word",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/internal/v1/sensitive-words/{{wordId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"value\": \"private phrase\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Update returns 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Update retains the identifier and normalizes the value\", () => { const r=pm.response.json(); pm.expect(r.id).to.equal(pm.collectionVariables.get(\"wordId\")); pm.expect(r.value).to.equal(\"PRIVATE PHRASE\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Delete word",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/internal/v1/sensitive-words/{{wordId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Delete returns 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Delete response has no body\", () => pm.expect(pm.response.text()).to.equal(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Import JSON dictionary file",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/internal/v1/sensitive-words/import",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Imported\", () => pm.response.to.have.status(200));",
              "pm.test(\"Counts reconcile\", () => { const r=pm.response.json(); pm.expect(r.received).to.equal(r.inserted + r.skippedDuplicates); });",
              "pm.test(\"Import counts are nonnegative integers\", () => { const r=pm.response.json(); [r.received,r.inserted,r.skippedDuplicates].forEach(n => { pm.expect(Number.isInteger(n)).to.equal(true); pm.expect(n).to.be.at.least(0); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Client cannot list dictionary",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/internal/v1/sensitive-words",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "client",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{clientPassword}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Forbidden\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    }
  ]
}
